rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if requesting user matches user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check user role from database
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getRole() == 'admin' ||
        request.auth.token.email == 'admin@acme.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    function isTrainer() {
      return isAuthenticated() && (
        getRole() == 'trainer' ||
        getRole() == 'faculty' ||
        getRole() == 'teacher'
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read, create, update, delete: if true;

      // User subcollections (lectures, notes, doubts, attempts)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Global Competency Catalog
    match /competencyCatalog/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Assessment Attempt Records
    match /assessmentAttempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Doubts / Inquiries
    match /doubts/{doubtId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin() ||
        isTrainer()
      );
      allow delete: if isAdmin();
    }

    // Certificates collection
    match /certificates/{certificateId} {
      allow read: if true; // Publicly readable for verification
      allow write: if isAdmin();
    }

    // Feedback / Telemetry collection
    match /feedback/{feedbackId} {
      allow create: if true; // Allow feedback/bug report submission for both authenticated and guest users
      allow read, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
