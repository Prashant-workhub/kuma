rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if requesting user matches user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check user role from database
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getRole() == 'admin' ||
        request.auth.token.email == 'admin@acme.com' ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    function isTrainer() {
      return isAuthenticated() && (
        getRole() == 'trainer' ||
        getRole() == 'faculty' ||
        getRole() == 'teacher'
      );
    }

    // User profiles collection
    match /users/{userId} {
      allow read, create, update, delete: if true;

      // User subcollections (lectures, notes, doubts, attempts)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Global Competency Catalog
    match /competencyCatalog/{document} {
      allow read, write: if true;
    }

    // Assessment Attempt Records
    match /assessmentAttempts/{attemptId} {
      allow read, write: if true;
    }

    // Doubts / Inquiries
    match /doubts/{doubtId} {
      allow read, write: if true;
    }

    // Trainer Assignments & Mentorship
    match /trainer_assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /teacherAssignments/{assignmentId} {
      allow read, write: if true;
    }

    // Pending Shares
    match /pendingShares/{shareId} {
      allow read, write: if true;
    }

    // Certificates collection
    match /certificates/{certificateId} {
      allow read, write: if true;
    }

    // Feedback / Telemetry collection
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
